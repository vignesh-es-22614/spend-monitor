# Copy to .env.deploy and fill in. .env.deploy is gitignored — never commit it.
#
#   copy .env.deploy.example .env.deploy
#   node scripts/prepare-deploy.js
#   catalyst deploy

# --- REQUIRED ---------------------------------------------------------------

# Path to the downloaded GCP service account key. Its contents get inlined
# into catalyst-config.json as GCP_SERVICE_ACCOUNT_JSON.
# Needs BigQuery Job User on it-security-online-marketing, plus Data Viewer
# on Google_ads_data_ajay and microsoft_ads_data.
GCP_SERVICE_ACCOUNT_KEY_FILE=C:\path\to\catalyst-sem-pacing-key.json

# Digest recipients, comma-separated.
MAIL_TO=vignesh.es@zohocorp.com

# --- MAIL -------------------------------------------------------------------

# The From address. With SMTP below this must be the authenticated mailbox —
# most providers reject a From that isn't the account sending.
MAIL_FROM=vignesh.es@zohocorp.com

# Fallback only. Catalyst Mail refuses to send from zohocorp.com until the
# DOMAIN is verified by DNS, which needs corporate IT. SMTP below sidesteps it.
# MON | MON,THU | DAILY | NEVER   (evaluated in IST; the dashboard overrides this)
EMAIL_DAYS=MON

# MAIL_CC=
# MAIL_DISPLAY_NAME=SEM Reporting

# --- SMTP (primary delivery) ------------------------------------------------
#
# Zoho Mail, India DC. SMTP_PASS must be an APP-SPECIFIC password:
#   Zoho Mail > Settings > Security > App Passwords > Generate
# Your normal login password will not work.
#
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=vignesh.es@zohocorp.com
SMTP_PASS=

# Set false only if you switch SMTP_PORT to 587 (STARTTLS).
# SMTP_SECURE=true

# --- DASHBOARD --------------------------------------------------------------

DASHBOARD_URL=https://spend-monitor-60080813873.development.catalystserverless.in/app/index.html

# --- OPTIONAL ---------------------------------------------------------------

# Pin the USD/INR rate instead of fetching it live.
# FX_INR_PER_USD=95.6

# Trailing window for the projection run-rate, in days.
# RECENT_WINDOW_DAYS=21

# Long random string; enables POST /server/spend_data/refresh.
# REFRESH_TOKEN=

# Pin the end date, for reproducing a past run.
# AS_OF=2026-08-27
